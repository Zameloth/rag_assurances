# Copy to .env and fill in. .env is gitignored and never committed.
# This template is the committed record of SPEC §16.3 — every variable the pipeline
# reads appears here, with the note that explains its value.

# --- OpenRouter (all three LLM roles) ---------------------------------------
# One key for generation, condensation and judging.
OPENROUTER_API_KEY=sk-or-v1-...

# The ablatable arm. The ladder swaps this; nothing else in the config moves with it.
GENERATION_MODEL="mistralai/mistral-large-2512"

# Controlled constant, held fixed across every rung. Deliberately its own key so an
# ablation of the generation model never drags the condenser along with it.
CONDENSER_MODEL="mistralai/mistral-small-3.2-24b-instruct"

# Must be a different family from every generation arm (SPEC §12.10) — a Mistral judge
# grading a Mistral arm scores its own family. The loader rejects a same-family judge.
JUDGE_MODEL="anthropic/claude-sonnet-5"

# --- Langfuse (tracing + eval) ---------------------------------------------
# Cloud, Hobby free tier, EU region. Keys from Project Settings -> API Keys.
# Needed only when LANGFUSE_TRACING is on; leave them as-is for a dev run.
LANGFUSE_PUBLIC_KEY=pk-lf-...
LANGFUSE_SECRET_KEY=sk-lf-...

# LANGFUSE_BASE_URL, *not* LANGFUSE_HOST — the latter is the dead SDK v3 name and v4
# ignores it silently (SPEC §11.3). The loader rejects LANGFUSE_HOST rather than let it
# pass unnoticed.
LANGFUSE_BASE_URL="https://cloud.langfuse.com"

# False in dev, true in prod, forced true inside run_experiment (SPEC §11.2). The free
# tier is 50k units/month and interactive debugging burns it faster than the whole
# ladder does — roughly 13 units a query, ~26k units a month at a hundred queries a day.
LANGFUSE_TRACING=false

# --- Qdrant ------------------------------------------------------------------
# The dev store from docker-compose.yml. In prod this is compose-internal
# (http://qdrant:6333) and no port is published anywhere.
QDRANT_URL="http://localhost:6333"
