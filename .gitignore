# Secrets — never commit. See .env.example for the expected keys.
.env
.env.local

# Python
__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/
.ruff_cache/
.mypy_cache/
*.egg-info/
.coverage

# Derived artifacts — the repo commits sources and decisions, never derived binaries
# (SPEC §16.5). Named exceptions live in eval/: the per-item scores and the golden set.
data/raw/*
!data/raw/.gitkeep

